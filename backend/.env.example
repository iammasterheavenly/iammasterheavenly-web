# Copy to .env for local use (never commit .env). On Render, add these under Environment.

# Extra CORS origins (comma-separated)
ALLOWED_ORIGINS=https://iammasterheavenly-web.pages.dev

# AI assistant (Anthropic Claude). Leave empty for demo mode.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Meta (WhatsApp Cloud API, Messenger, Instagram DMs)
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
WHATSAPP_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0
