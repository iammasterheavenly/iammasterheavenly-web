# URL of the FastAPI backend (no trailing slash).
# Local:      http://localhost:8000
# Production: https://iammasterheavenly-api.onrender.com
VITE_API_URL=http://localhost:8000

# AI assistant launch links. Leave a value empty to show "Coming soon" on that card.
# WhatsApp number, digits only with country code, e.g. 27821234567
VITE_WHATSAPP_NUMBER=
# Telegram bot username, e.g. IAmMasterBot
VITE_TELEGRAM_BOT=
# Facebook Page username
VITE_MESSENGER_PAGE=
# Instagram username
VITE_INSTAGRAM_HANDLE=
